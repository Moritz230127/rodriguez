# Maintainer: Moritz230127 <moritz230127@users.noreply.github.com>
# 预编译包；源码与对应许可证见 https://github.com/Moritz230127/niri-side-note
#
# CI 会解析 niri-side-note 的最新 Release，注入 NIRI_PKGVER / NIRI_PKGREL /
# NIRI_ASSET / NIRI_URL / NIRI_SHA256；本地也可以显式传这些变量来构建。

pkgname=niri-side-note-bin
pkgver=${NIRI_PKGVER:-0.11.0}
pkgrel=${NIRI_PKGREL:-1}
pkgdesc='Niri 侧笺——贴边便签笔记（预编译二进制）'
arch=('x86_64')
url='https://github.com/Moritz230127/niri-side-note'
license=('MPL-2.0' 'OFL-1.1' 'MIT')
depends=('cairo' 'dbus' 'fontconfig' 'gdk-pixbuf2' 'glib2' 'glibc' 'graphene'
         'gtk4' 'gtk4-layer-shell' 'libadwaita' 'libgcc' 'pango' 'sqlite' 'librsvg')
provides=('niri-side-note')
conflicts=('stickies-cn')
options=('!strip' '!debug')

_asset=${NIRI_ASSET:-niri-side-note-0.11.0-linux-x86_64.tar.gz}
_url=${NIRI_URL:-https://github.com/Moritz230127/niri-side-note/releases/download/v0.11.0-niri.1/$_asset}
_sha256=${NIRI_SHA256:-c8d65bb6824db38098146d0e34a63931e7e081faa21ebaa2941d40ccfeb4b322}

source=("$_asset::$_url")
sha256sums=("$_sha256")

package() {
  cd "niri-side-note-$pkgver-linux-x86_64"

  install -Dm755 bin/niri-side-note "$pkgdir/usr/bin/niri-side-note"
  install -Dm644 share/applications/niri-side-note.desktop \
    "$pkgdir/usr/share/applications/niri-side-note.desktop"
  install -Dm644 share/icons/hicolor/128x128/apps/dev.stickies.Stickies.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/dev.stickies.Stickies.png"
  install -Dm644 share/doc/niri-side-note/README.md \
    "$pkgdir/usr/share/doc/niri-side-note/README.md"
  install -Dm644 share/licenses/niri-side-note/LICENSE \
    "$pkgdir/usr/share/licenses/niri-side-note/LICENSE"
  install -Dm644 share/licenses/niri-side-note/NOTICE \
    "$pkgdir/usr/share/licenses/niri-side-note/NOTICE"

  if [[ -d share/licenses/niri-side-note/fonts ]]; then
    install -d "$pkgdir/usr/share/licenses/niri-side-note/fonts"
    install -m644 share/licenses/niri-side-note/fonts/* \
      "$pkgdir/usr/share/licenses/niri-side-note/fonts/"
  fi
}
