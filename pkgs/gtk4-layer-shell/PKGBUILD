# Maintainer: Moritz230127 <moritz230127@users.noreply.github.com>
# 上游：https://github.com/wmww/gtk4-layer-shell

pkgname=gtk4-layer-shell
pkgver=1.3.0
pkgrel=1
pkgdesc='Library to create panels and other desktop components for Wayland (GTK4)'
arch=('x86_64')
url='https://github.com/wmww/gtk4-layer-shell'
license=('MIT')
depends=('gtk4' 'wayland')
makedepends=('meson' 'ninja' 'wayland-protocols')
provides=('gtk4-layer-shell')
conflicts=('gtk4-layer-shell-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1ebb01ab14e98afd1727f68f64981c37bd23305b1f131f5667c02b94cf593192')

build() {
  cd "$pkgname-$pkgver"
  meson setup --prefix=/usr --buildtype=plain --wrap-mode=nofallback \
    -Dtests=false -Ddocs=false -Dintrospection=false -Dvapi=false \
    -Dexamples=false -Dsmoke-tests=false build
  meson compile -C build
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
